package com.rays.exercise.javabasics;
public class MultiplicationTables2D {
    public static void main(String[] args) {
        int[][] tables = new int[9][10]; // 2 to 10, 10 rows each

        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 10; j++) {
                tables[i][j] = (i + 2) * (j + 1);
            }
        }

        for (int i = 0; i < 9; i++) {
            System.out.println("Table of " + (i + 2) + ":");
            for (int j = 0; j < 10; j++) {
                System.out.println((i + 2) + " x " + (j + 1) + " = " + tables[i][j]);
            }
            System.out.println();
        }
    }
}
