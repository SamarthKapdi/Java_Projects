package com.rays.exercise.javabasics;
public class MeanAverageOddEven {
    public static void main(String[] args) {
        int N = 10;
        int oddSum = 0, evenSum = 0;
        
        for (int i = 1, odd = 1, even = 2; i <= N; i++, odd += 2, even += 2) {
            oddSum += odd;
            evenSum += even;
        }
        
        System.out.println("Mean of first " + N + " odd numbers: " + (oddSum / (double)N));
        System.out.println("Mean of first " + N + " even numbers: " + (evenSum / (double)N));
    }
}
